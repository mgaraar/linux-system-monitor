[Unit]
Description=Linux System Monitor
Documentation=https://github.com/mgaraar/linux-system-monitor
After=network.target

[Service]
Type=oneshot
# Sesuaikan path instalasi dengan lokasi project di mesin ini.
ExecStart=/usr/bin/bash /opt/linux-system-monitor/monitor.sh
WorkingDirectory=/opt/linux-system-monitor
Nice=10
# Jalankan sebagai user biasa bila tidak perlu akses root:
# User=nobody
# Group=nogroup
